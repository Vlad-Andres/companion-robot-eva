# Copy to server/.env and edit. Real environment variables override these,
# so `EVA_PORT=9000 make server` still wins over anything set here.
# server/.env is gitignored — never commit it.

# --- Server ---
# EVA_HOST=0.0.0.0
# EVA_PORT=8002

# --- Audio ---
# How long a pause ends an utterance. This is the only finalisation path
# today: the robot does not send audio.end yet.
# EVA_AUDIO_IDLE_SECONDS=0.9
# EVA_AUDIO_MAX_BYTES=2000000

# --- Speech to text ---
# EVA_SPEECH_TO_TEXT_MODEL=small.en
# Set to force a fixed transcript instead of running the recogniser (testing).
# EVA_SPEECH_TO_TEXT_STUB_TEXT=

# --- Text to speech ---
# EVA_TEXT_TO_SPEECH_ENABLED=true
# auto = use piper if it actually works, else fall back to macOS `say`.
# Other values: piper, macos_say, off
# EVA_TEXT_TO_SPEECH_ENGINE=auto

# --- Language model (needs ollama running) ---
# Off by default: rule-matched commands work without it.
# EVA_LANGUAGE_MODEL_ENABLED=false
# EVA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EVA_OLLAMA_MODEL=llama3.2:3b
# EVA_OLLAMA_TIMEOUT_SECONDS=30

# --- Training data capture ---
# Records every finalised utterance as a WAV plus a labelled manifest row, to
# train the on-device intent model later. This captures everything said near the
# robot, so it is off by default and writes only to EVA_DATASET_DIR.
# Inspect what you have with: python tools/dataset_summary.py
EVA_DATASET_CAPTURE_ENABLED=false
# EVA_DATASET_DIR=dataset
# Capture pauses once the directory reaches this size (default 2 GB).
# EVA_DATASET_MAX_BYTES=2000000000
